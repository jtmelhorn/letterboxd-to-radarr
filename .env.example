# Copy to .env and fill in your values:
#   cp .env.example .env

# Port exposed on the host. Change this if 3080 conflicts with another service.
# Common *arr ports to avoid: 7878 (Radarr), 8686 (Lidarr),
# 8787 (Readarr), 9696 (Prowlarr), 6767 (Bazarr).
HOST_PORT=3080

# Letterboxd username shown on the dashboard.
REVIEWER=your-letterboxd-username

# Radarr connection.
RADARR=http://192.168.1.100:7878
API_KEY=your-radarr-api-key

# Persistent app data (settings + review cache). Host path that gets
# mounted into the container at /data. Defaults to ./data next to this file.
# Example RHEL path: DATA_DIR=/opt/letterboxd-to-radarr/data
DATA_DIR=./data
